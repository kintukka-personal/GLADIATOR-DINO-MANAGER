{
  "name": "jurassic-ludus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jurassic Ludus: a dinosaur gladiator management sim with ARK-style breeding, built on the systems of Gladiator Manager.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "vite build --mode artifact && node scripts/make-artifact.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "vitest run tests/longrun.test.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "playwright": "^1.49.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.8"
  }
}
